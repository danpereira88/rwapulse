# Etherscan free API key — sign up at https://etherscan.io/apis
ETHERSCAN_API_KEY=your_key_here

# The Graph free API key — sign up at https://thegraph.com/studio/apikeys/
# Free tier: 100,000 queries/month. Required for Maple, Centrifuge, Goldfinch subgraphs.
THE_GRAPH_API_KEY=your_key_here

# CoinGecko free "Demo" API key — https://www.coingecko.com/en/api (no credit card)
# Required for historical /market_chart data. Current market data works without it.
COINGECKO_API_KEY=your_key_here

# Optional: Ethereum RPC URL (Alchemy, Infura, etc.)
# If not set, falls back to public endpoints (Cloudflare, Ankr, LlamaRPC)
ETHEREUM_RPC_URL=

# Supabase — Postgres connection string
# Find at: Supabase dashboard → Settings → Database → Connection string (URI)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
SUPABASE_DB_URL=
